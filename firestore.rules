rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow everyone to read public blog posts
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && hasAdminRole();
      allow update: if isAuthenticated() && hasAdminRole() && isBlogPostUpdate();
      allow delete: if isAuthenticated() && hasAdminRole();
    }

    // Only authenticated users can read their own user data
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if isAuthenticated() && request.auth.uid == userId && isValidUser();
    }

    // Admin dashboard data - admin only
    match /admin/{document=**} {
      allow read, write: if isAuthenticated() && hasAdminRole();
    }

    // Contact form submissions
    match /contact_submissions/{submissionId} {
      allow read: if false; // Never read back
      allow create: if isValidContactForm();
    }

    // Donations - write only
    match /donations/{donationId} {
      allow read: if false;
      allow create: if isValidDonation();
    }

    // Comments on blog posts
    match /posts/{postId}/comments/{commentId} {
      allow read: if true;
      allow create: if isValidComment();
      allow update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || hasAdminRole()
      );
    }

    // Security logs - admin only
    match /security_logs/{logId} {
      allow read: if isAuthenticated() && hasAdminRole();
      allow write: if false;
    }

    // Translations/Content
    match /translations/{language}/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated() && hasAdminRole();
    }

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasAdminRole() {
      return request.auth.token.role == 'admin';
    }

    function hasEditorRole() {
      return request.auth.token.role in ['admin', 'editor'];
    }

    function isBlogPostUpdate() {
      let update = request.resource.data;
      let current = resource.data;

      // Can't change these fields after creation
      return update.createdAt == current.createdAt &&
             update.authorId == current.authorId;
    }

    function isValidUser() {
      let user = request.resource.data;
      return user.email is string &&
             user.email.size() > 0 &&
             user.name is string &&
             user.name.size() > 0 &&
             user.role in ['admin', 'editor', 'viewer'];
    }

    function isValidContactForm() {
      let form = request.resource.data;
      return form.name is string &&
             form.name.size() >= 2 &&
             form.email is string &&
             form.email.size() > 0 &&
             form.subject is string &&
             form.subject.size() >= 5 &&
             form.message is string &&
             form.message.size() >= 10 &&
             form.message.size() <= 5000 &&
             form.createdAt == request.time;
    }

    function isValidDonation() {
      let donation = request.resource.data;
      return donation.amount is number &&
             donation.amount > 0 &&
             donation.amount <= 100000 &&
             donation.currency in ['USD', 'EUR', 'MXN'] &&
             donation.email is string &&
             donation.name is string &&
             donation.name.size() >= 2 &&
             donation.createdAt == request.time;
    }

    function isValidComment() {
      let comment = request.resource.data;
      return comment.content is string &&
             comment.content.size() >= 3 &&
             comment.content.size() <= 1000 &&
             comment.userId is string &&
             comment.email is string &&
             comment.name is string &&
             comment.createdAt == request.time;
    }
  }
}
