# Public Firebase Config
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Admin SDK (Server-side only - encode as base64)
# Get from Firebase Console > Project Settings > Service Accounts
# Then: cat service-account.json | base64 | tr -d '\n'
FIREBASE_ADMIN_SDK_KEY=base64_encoded_service_account_key
FIREBASE_STORAGE_BUCKET=your_project.appspot.com

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Fundación Romus

# API Configuration
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# Analytics (Optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G_MEASUREMENT_ID

# Security
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret

# Email (Optional - for contact form)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@fundacionromus.org

# Sentry (Optional - error tracking)
SENTRY_AUTH_TOKEN=your_sentry_token
SENTRY_PROJECT_ID=your_sentry_project
